# ── Database ────────────────────────────────────────────────────
# Docker: postgresql+asyncpg://router:<password>@postgres:5432/ws_router
# Local:  postgresql+asyncpg://router:<password>@localhost:5432/ws_router
DATABASE_URL=postgresql+asyncpg://router:router@postgres:5432/ws_router

# ── Mattermost ─────────────────────────────────────────────────
ENABLE_MATTERMOST=true
MATTERMOST_URL=https://mattermost.example.com
MATTERMOST_TOKEN=replace-with-your-bot-token
MATTERMOST_BOT_USERNAME=openclaw

# ── Telegram ───────────────────────────────────────────────────
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=

# ── Bitrix24 ───────────────────────────────────────────────────
ENABLE_BITRIX=false
BITRIX_WEBHOOK_URL=
BITRIX_BOT_ID=0
# Token of the Bitrix24 incoming webhook. Inbound events to
# POST /api/v1/bitrix/event must present it (auth.access_token or ?secure=).
# Empty = webhook endpoint disabled.
BITRIX_INBOUND_SECRET=

# ── Slack (Socket Mode) ────────────────────────────────────────
ENABLE_SLACK=false
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ── VK Teams (Myteam) ──────────────────────────────────────────
ENABLE_VK_TEAMS=false
VK_TEAMS_BOT_TOKEN=
VK_TEAMS_API_URL=https://myteam.mail.ru/bot/v1

# ── Microsoft Teams ────────────────────────────────────────────
ENABLE_TEAMS=false
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
# Inbound JWT verification for POST /api/v1/teams/messages.
# Defaults are fine for Azure Bot Service; overrides shown for completeness.
# Expected token audience (defaults to TEAMS_APP_ID when empty):
#TEAMS_JWT_AUDIENCE=
#TEAMS_JWKS_URLS=https://login.microsoftonline.com/common/discovery/keys,https://login.microsoftonline.com/common/discovery/v2.0/keys
#TEAMS_ALLOWED_ISSUERS=https://api.botframework.com,https://sts.windows.net/d6d49420-f39b-4df7-a1dc-d59a935871db/,https://login.microsoftonline.com/d6d49420-f39b-4df7-a1dc-d59a935871db/v2.0
# HTTPS hosts allowed as activity serviceUrl (our Bearer token is only sent there):
#TEAMS_ALLOWED_SERVICE_URL_HOSTS=smba.trafficmanager.net,smtg.trafficmanager.net

# ── WS Connection Manager ─────────────────────────────────────
WS_IDLE_TIMEOUT_SEC=1800
WS_CLEANUP_INTERVAL_SEC=300
WS_RECONNECT_MAX_RETRIES=3
WS_RECONNECT_BASE_DELAY_SEC=1.0
# TTL (seconds) of per-process mapping caches. Cache entries are also checked
# against the global mapping_state version, so app-side mutations are visible
# across replicas immediately; this TTL only bounds external (direct SQL) edits.
MAPPING_CACHE_TTL_SEC=300

# ── Control-Plane API ──────────────────────────────────────────
# Secret token for POST /api/v1/trigger and POST /api/v1/notify
# Header: X-Api-Token
API_TOKEN=change-me-to-a-strong-secret
# Internal endpoint for proxy /api/v1/mm/action (Mattermost buttons)
MM_ACTION_PROXY_URL=http://tools-server:3000/mm/action
# Shared secret for POST /api/v1/mm/action. Pass it as the
# X-MM-Action-Secret header or append ?secret=<value> to the callback URL
# registered in Mattermost. Empty = endpoint disabled.
MM_ACTION_SHARED_SECRET=

# ── Credential Encryption ──────────────────────────────────────
# Fernet key used to encrypt OpenClaw private keys and tokens at rest in
# PostgreSQL. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# After setting it, run scripts/encrypt_existing_credentials.py once.
# Empty = credentials are stored as plaintext (dev only).
CREDENTIAL_ENCRYPTION_KEY=

# ── Server ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8060
LOG_LEVEL=INFO

# ── Attachments (Shared Volumes) ───────────────────────────────
# Host path mounted to /configs inside clawmux.
OPENCLAW_CONFIGS_PATH=./configs
# Path inside clawmux container where OpenClaw user configs are mounted.
WORKSPACE_BASE_PATH=/configs
# Max file size for download/upload (MB). Files over limit are skipped.
ATTACHMENT_MAX_SIZE_MB=50
# Workspace root path inside the OpenClaw container
CONTAINER_WORKSPACE_ROOT=/home/node/.openclaw/workspace

# ── Dify Fallback Bot ──────────────────────────────────────────
# When a user has no OpenClaw instance, their messages are forwarded
# to a Dify chatbot instead of showing an error.
# Leave DIFY_API_KEY empty to disable this fallback (show error message).
DIFY_BASE_URL=http://localhost:8081/v1
DIFY_API_KEY=
# Max seconds to wait for Dify streaming response
DIFY_TIMEOUT_SEC=120
