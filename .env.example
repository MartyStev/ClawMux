# ── Database (существующий openclaw-postgres) ─────────────────
# Docker: postgresql+asyncpg://openclaw:<password>@openclaw-postgres:5432/ws_router
# Локально (ssh tunnel): postgresql+asyncpg://openclaw:<password>@localhost:5432/ws_router
DATABASE_URL=postgresql+asyncpg://openclaw:xK9mP2vL8nQw4RjT@openclaw-postgres:5432/ws_router

# ── Mattermost ─────────────────────────────────────────────────
MATTERMOST_URL=https://mattermost.homeapp.team
MATTERMOST_TOKEN=uribuftnk7dume7uoej8g8jbkc
MATTERMOST_BOT_USERNAME=openclaw

# ── OpenClaw ───────────────────────────────────────────────────
OPENCLAW_GATEWAY_TOKEN=your-gateway-token-here

# ── WS Connection Manager ─────────────────────────────────────
WS_IDLE_TIMEOUT_SEC=1800
WS_CLEANUP_INTERVAL_SEC=300
WS_RECONNECT_MAX_RETRIES=3
WS_RECONNECT_BASE_DELAY_SEC=1.0

# ── Control-Plane API ──────────────────────────────────────────
# Секретный токен для POST /api/v1/trigger (заголовок X-Api-Token)
API_TOKEN=change-me-to-a-strong-secret

# ── Server ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8060
LOG_LEVEL=INFO

# ── Attachments (Shared Volumes) ───────────────────────────────
# Path inside ws_router container where /root/openclaw/user-configs is mounted
WORKSPACE_BASE_PATH=/configs
# Max file size for download/upload (MB). Files over limit are skipped.
ATTACHMENT_MAX_SIZE_MB=50
# Workspace root path inside the OpenClaw container
CONTAINER_WORKSPACE_ROOT=/home/node/.openclaw/workspace

# ── Dify Fallback Bot ──────────────────────────────────────────
# When a user has no OpenClaw instance, their messages are forwarded
# to a Dify chatbot instead of showing an error.
# Leave DIFY_API_KEY empty to disable this fallback (show error message).
#
# IMPORTANT: Use the internal Docker host address (not the public domain),
# because ws_router runs inside a container. 172.17.0.1 is the default
# Docker bridge gateway — Dify's nginx reverse-proxy listens on port 8081.
# If your Docker network differs, use: $(docker network inspect bridge -f '{{range .IPAM.Config}}{{.Gateway}}{{end}}')
DIFY_BASE_URL=http://172.17.0.1:8081/v1
DIFY_API_KEY=
# Max seconds to wait for Dify streaming response
DIFY_TIMEOUT_SEC=120
