{
  "$schema": "https://openclaw.ai/schemas/openclaw.json",
  "version": "1.0",
  "instance": {
    "name": "Corporate-AI-Workspace-{{USER_ID}}",
    "provider": "{{PROVIDER}}"
  },
  "agent": {
    "instructions": "AGENTS.md",
    "temperature": 0.3,
    "max_tokens": 4096
  },
  "mcp_servers": {
    "confluence": {
      "type": "http",
      "url": "http://mcp-confluence:8080/v1"
    },
    "jira": {
      "type": "http",
      "url": "http://mcp-jira:8080/v1"
    },
    "postgres_db": {
      "type": "std",
      "command": "mcp-server-postgres",
      "args": ["--connection-string", "env:CORPORATE_READONLY_DB_URL"]
    }
  }
}
